<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/GaussianPly.cs" Link="GaussianPly.cs" />
    <None Include="Fixtures/*.ply" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveUnusedAspNetPack" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup><KnownFrameworkReference Remove="Microsoft.AspNetCore.App" /></ItemGroup>
  </Target>
</Project>
