#!/usr/bin/env bash
set -euo pipefail
app_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  echo 'room2blender requires uv. Alternatively install requirements.txt in a venv and run scripts/pipeline.py.' >&2
  exit 1
fi
exec uv run --locked --project "$app_dir" python "$app_dir/scripts/pipeline.py" "$@"
